
/* 布局：惩戒骑作战卡。技能时间轴 → 必会四招 → 三个关键处理 → 按路线逐段 → 工具箱 → 天赋。暗色邪能暗巷主题，圣骑士粉为强调色，邪能绿作次色。 */
:root{
  --bg:#100e0d; --panel:#181514; --panel-2:#201c1a; --line:#332d29;
  --ink:#ebe7da; --mute:#9d99a6; --faint:#65616e;
  --gold:#f39cc3; --gold-dim:#86506a;
  --venom:#9bd65f; --blood:#e46a5e; --arcane:#79a9f2;
  --display:"Noto Serif SC","Songti SC","STSong",serif;
  --body:"Noto Sans SC","PingFang SC","Microsoft YaHei",system-ui,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,Menlo,monospace;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{background:var(--bg)}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.65 var(--body);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--gold);outline-offset:2px;border-radius:4px}
img.ic{width:28px;height:28px;border-radius:6px;border:1px solid #000;box-shadow:0 0 0 1px var(--line);flex:none;display:block}
img.ic.lg{width:44px;height:44px;border-radius:9px}
img.ic.sm{width:22px;height:22px;border-radius:5px}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
h1,h2,h3{font-family:var(--display);text-wrap:balance;margin:0;letter-spacing:.01em}
h2{font-size:24px;font-weight:900;display:flex;align-items:baseline;gap:14px}
h2 .k{font:700 12px var(--mono);color:var(--gold);letter-spacing:.12em}
.sub{color:var(--mute);font-size:14px;margin:6px 0 0}
section{padding:44px 0 8px}
.mono{font-family:var(--mono);font-variant-numeric:tabular-nums}

/* hero */
header{border-bottom:1px solid var(--line);background:
  radial-gradient(900px 300px at 85% -40%,rgba(243,156,195,.13),transparent 70%),
  radial-gradient(700px 260px at 0% 120%,rgba(155,214,95,.08),transparent 70%)}
header .wrap{padding-top:44px;padding-bottom:34px;display:grid;gap:18px}
.eyebrow{font:700 12px var(--mono);letter-spacing:.16em;color:var(--mute)}
h1{font-size:clamp(32px,6vw,52px);font-weight:900;line-height:1.1}
h1 .cls{color:var(--gold)}
h1 .dot{color:var(--faint);margin:0 .2em}
.lede{max-width:62ch;color:#d6d2c4;font-size:16px;margin:0}
.lede b{color:var(--gold);font-weight:700}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1px solid var(--line);background:var(--panel);border-radius:999px;padding:4px 12px;font-size:13px;color:var(--mute)}
.chip b{color:var(--ink);font-weight:500}

{{TLCSS}}
/* key moments */
.moments{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px;margin-top:20px}
.mo{background:var(--panel);border:1px solid var(--line);border-top:3px solid var(--gold);border-radius:12px;padding:16px;display:grid;gap:10px;align-content:start}
.mo .where{font:700 11px var(--mono);letter-spacing:.1em;color:var(--mute)}
.mo .sig{font-size:14px;color:var(--mute)}
.mo .sig b{color:var(--ink);font-size:16px;font-weight:700;display:block}
.mo .act{display:flex;align-items:center;gap:10px;font-weight:700;font-size:17px}
.mo .act .arrow{color:var(--gold);font-size:18px}
.mo p{margin:0;font-size:14px;color:#cfcbbd}

/* pills */
.pill{display:inline-block;font-size:11px;font-weight:700;padding:1px 7px;border-radius:5px;line-height:18px;white-space:nowrap}
.p-imm{background:rgba(243,156,195,.16);color:var(--gold)}
.p-clr{background:rgba(155,214,95,.16);color:var(--venom)}
.p-dr{background:rgba(121,169,242,.16);color:var(--arcane)}
.p-mv{background:rgba(255,255,255,.07);color:var(--mute)}
.p-heal{background:rgba(228,106,94,.15);color:var(--blood)}
.tag{display:inline-block;font-size:11px;color:var(--mute);border:1px solid var(--line);border-radius:4px;padding:0 5px;margin-right:4px;line-height:17px;white-space:nowrap}
.tag.fel{color:var(--venom);border-color:rgba(155,214,95,.35)}
.tag.poison{color:var(--venom);border-color:rgba(155,214,95,.35)}
.tag.magic{color:var(--arcane);border-color:rgba(121,169,242,.35)}
.tag.bleed{color:var(--blood);border-color:rgba(228,106,94,.35)}

/* evasion finding */
.finding{margin-top:20px;display:grid;grid-template-columns:1.1fr 1fr;gap:22px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:22px}
.finding h3{font-size:20px;font-weight:900;display:flex;gap:10px;align-items:center}
.finding p{margin:10px 0 0;color:#d2cec0;font-size:14.5px}
.finding p b{color:var(--gold)}
.bars{display:grid;gap:14px;align-content:center}
.bar-row{display:grid;grid-template-columns:96px 1fr;gap:10px;align-items:center;font-size:13px;color:var(--mute)}
.bar{height:30px;background:var(--panel-2);border-radius:6px;position:relative;overflow:hidden}
.bar span{position:absolute;inset:0 auto 0 0;border-radius:6px;display:flex;align-items:center;justify-content:flex-end;padding-right:10px;font:700 13px var(--mono);color:#14110a}
.bar .off{background:#8f9a93}
.bar .on{background:var(--gold)}
.bars .cap{font-size:12px;color:var(--faint);line-height:1.5}
.bars .delta{font:700 28px var(--mono);color:var(--gold)}
.bars .delta small{font:500 13px var(--body);color:var(--mute);margin-left:8px}

/* route */
.route{margin-top:22px;position:relative;display:grid;gap:18px}
.route::before{content:"";position:absolute;left:19px;top:10px;bottom:10px;width:2px;background:linear-gradient(var(--line),var(--gold-dim),var(--line))}
.stop{display:grid;grid-template-columns:40px 1fr;gap:14px}
.node{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font:900 16px var(--display);position:relative;z-index:1}
.stop.boss .node{background:var(--gold);color:#17140a}
.stop.trash .node{background:var(--panel-2);border:2px solid var(--line);color:var(--faint);font-size:12px}
.stop-body{background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.stop.boss .stop-body{border-color:#4a2f3c}
.stop-head{padding:12px 16px;display:flex;align-items:baseline;gap:10px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.stop-head h3{font-size:18px;font-weight:900}
.stop.trash .stop-head h3{font-size:16px;font-weight:600;color:#cfcbbd}
.stop-head .kind{font:700 11px var(--mono);letter-spacing:.1em;color:var(--mute)}
.row{display:grid;grid-template-columns:minmax(170px,1.15fr) 24px minmax(150px,1fr) minmax(130px,1fr);gap:12px;align-items:center;padding:11px 16px;border-bottom:1px solid var(--line)}
.row:last-of-type{border-bottom:0}
.mech{display:flex;gap:10px;align-items:center}
.mech .n{font-weight:700}
.mech .s{font-size:12.5px;color:var(--mute)}
.row .to{color:var(--gold);text-align:center;font-weight:700}
.skill{display:flex;gap:9px;align-items:center;font-weight:700}
.skill .pill{margin-left:2px}
.row .why{font-size:13.5px;color:#cfcbbd}
.note{padding:10px 16px;font-size:13.5px;background:rgba(243,156,195,.06);color:#d9d0a6;border-top:1px solid var(--line)}
.note.warn{background:rgba(228,106,94,.08);color:#f0b6ae}
.note b{color:var(--gold)}
.note.warn b{color:var(--blood)}

/* toolbox */
.tools{margin-top:20px;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.tool{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px;display:grid;gap:8px;align-content:start}
.tool .top{display:flex;gap:10px;align-items:center}
.tool .nm{font-weight:700;font-size:16px}
.tool .dl{display:grid;grid-template-columns:44px 1fr;gap:3px 8px;font-size:13px}
.tool .dl dt{color:var(--faint)}
.tool .dl dd{margin:0;color:#d2cec0}
.tool.star{border-color:var(--gold-dim);background:linear-gradient(180deg,rgba(243,156,195,.07),var(--panel) 60%)}

/* debuffs */
.tbl-wrap{margin-top:18px;overflow-x:auto;border:1px solid var(--line);border-radius:12px}
table{width:100%;border-collapse:collapse;min-width:620px;background:var(--panel)}
th{font:700 11px var(--mono);letter-spacing:.1em;color:var(--mute);text-align:left;padding:10px 14px;background:var(--panel-2);border-bottom:1px solid var(--line)}
td{padding:10px 14px;border-bottom:1px solid var(--line);font-size:14px;vertical-align:middle}
tr:last-child td{border-bottom:0}
.dname{display:flex;gap:10px;align-items:center;font-weight:700}
.yes{color:var(--venom);font-weight:700}
.no{color:var(--faint)}

/* unclear + sources */
.two{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:18px}
.box{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px 18px}
.box h3{font-size:16px;font-weight:900;margin-bottom:8px}
.box ul{margin:0;padding-left:18px;display:grid;gap:8px;font-size:13.5px;color:#cfcbbd}
.box li b{color:var(--ink)}
.runs{display:grid;gap:8px;font-size:13px}
.runs a{display:grid;grid-template-columns:22px 1fr auto;gap:8px;align-items:center;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--panel-2)}
.runs a:hover{border-color:var(--gold-dim)}
.runs .tm{font-family:var(--mono);color:var(--gold);font-weight:700}
.runs .ix{font:700 12px var(--mono);color:var(--faint)}
.small{font-size:12px;color:var(--faint);margin-top:10px;line-height:1.6}
.talent{margin-top:18px;background:var(--panel);border:1px solid var(--gold-dim);border-radius:14px;padding:18px;display:grid;gap:16px}
.code-row{display:flex;gap:10px;align-items:stretch}
.code-row code{flex:1;min-width:0;font:500 13px/1.5 var(--mono);color:var(--gold);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px 12px;word-break:break-all;user-select:all}
.code-row button{flex:none;font:700 14px var(--body);color:#17140a;background:var(--gold);border:0;border-radius:8px;padding:0 20px;cursor:pointer}
.code-row button:hover{filter:brightness(1.08)}
.code-row button:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.tal-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px}
.tal{display:flex;gap:10px;align-items:center;padding:10px;border:1px solid var(--line);border-radius:10px;background:var(--panel-2);font-size:13px}
.tal b{font-size:14px;margin-right:4px}
.tal span{display:block;color:var(--mute)}
.tal.key{border-color:var(--gold-dim)}
.tal.key b{color:var(--gold)}
.refs{font-size:12.5px;color:var(--faint);display:flex;flex-wrap:wrap;gap:6px 14px}
.refs a{color:var(--mute);border-bottom:1px dotted var(--faint)}
.refs a:hover{color:var(--gold)}
footer{padding:40px 0 56px;color:var(--faint);font-size:12px}

@media (max-width:760px){
  .finding,.two{grid-template-columns:1fr}
  .row{grid-template-columns:1fr;gap:6px}
  .row .to{display:none}
  .row .skill::before{content:"→";color:var(--gold);margin-right:2px}
  .route::before{left:15px}
  .stop{grid-template-columns:32px 1fr;gap:10px}
  .node{width:32px;height:32px;font-size:14px}
}
@media (prefers-reduced-motion:no-preference){
  .mo,.tool{transition:border-color .2s}
  .mo:hover,.tool:hover{border-color:var(--gold-dim)}
}

.p-par{background:rgba(243,156,195,.18);color:var(--gold)}
.p-ref{background:rgba(121,169,242,.16);color:var(--arcane)}
.p-cc{background:rgba(155,214,95,.14);color:var(--venom)}
.combo{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:14px}
.combo .st{display:flex;align-items:center;gap:8px;background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:8px 12px 8px 8px}
.combo .st b{display:block;font-size:14px}
.combo .st span{display:block;font:500 11.5px var(--mono);color:var(--mute)}
.combo .st.hit{border-color:var(--gold-dim)}
.combo .ar{color:var(--gold);font-weight:700}
.finding + .finding{margin-top:16px}
.bar .em{position:absolute;top:0;bottom:0;display:flex;align-items:center;font:700 13px var(--mono);color:var(--gold)}

