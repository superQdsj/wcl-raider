<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>惩戒骑 · 虚空之痕竞技场 应对手册</title>
<style>
/* 惩戒骑 · 虚空之痕竞技场（圣骑士粉暗底）：一条路线讲到底，顶部速记 + 高频职责跳转 + 阶段导航。
   换职业只改 :root 变量即可，:root 之外零硬编码色值。
   路线内主强调色（--gold）严格只表达「必做」；次色（--tl-e / --tl-v）仅用于时间轴副手牌标记；红（--blood）仅用于硬限制与高压警示。
   纯系统字体，无外部资源依赖。 */
:root{
  --bg:#100e0d; --nav-bg:rgba(16,14,13,.92);
  --panel:#181514; --panel-2:#201c1a; --line:#332d29; --line-2:#463e38;
  --tint-1:rgba(255,255,255,.018); --tint-2:rgba(255,255,255,.045); --ic-edge:#000;
  --ink:#ebe7da; --ink-2:#d4cec2; --mute:#a8a3b0; --faint:#8a8594;
  --gold:#f39cc3; --gold-dim:#86506a; --on-gold:#1b0e14;
  --gold-bg:rgba(243,156,195,.08); --gold-chip:rgba(243,156,195,.15); --gold-band:rgba(243,156,195,.13);
  --hero-a:rgba(243,156,195,.14); --hero-b:rgba(88,179,155,.09);
  --tl-e:#6cc7ae; --tl-v:#e6be67;
  --bar-off:#848e88; --bar-mid:#b8c4bc; --on-bar:#141916;
  --blood:#eb7a6e; --blood-bg:rgba(235,122,110,.09); --blood-line:rgba(235,122,110,.34);
  --display:"Songti SC","STSong","Noto Serif SC","Source Han Serif SC",Georgia,serif;
  --body:"PingFang SC","Hiragino Sans GB","Noto Sans SC","Microsoft YaHei",system-ui,sans-serif;
  --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{background:var(--bg);scroll-behavior:smooth;scroll-padding-top:68px}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.68 var(--body);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible{outline:2px solid var(--gold);outline-offset:2px;border-radius:4px}
img.ic{width:28px;height:28px;border-radius:6px;border:1px solid var(--ic-edge);box-shadow:0 0 0 1px var(--line-2);flex:none;display:block}
img.ic.lg{width:38px;height:38px;border-radius:8px}
img.ic.sm{width:20px;height:20px;border-radius:5px}
.wrap{max-width:1060px;margin:0 auto;padding:0 20px}
h1,h2,h3{font-family:var(--display);text-wrap:balance;margin:0;letter-spacing:.01em}
h2{font-size:23px;font-weight:900;display:flex;align-items:baseline;gap:12px}
h2 .k{font:700 12px var(--mono);color:var(--mute);letter-spacing:.12em}
.sub{color:var(--mute);font-size:14px;margin:6px 0 0}
section{padding:40px 0 6px}

/* hero */
header{border-bottom:1px solid var(--line);background:
  radial-gradient(900px 320px at 88% -40%,var(--hero-a),transparent 70%),
  radial-gradient(700px 260px at 0% 130%,var(--hero-b),transparent 70%)}
header .wrap{padding-top:42px;padding-bottom:30px;display:grid;gap:16px}
.eyebrow{font:700 12px var(--mono);letter-spacing:.16em;color:var(--mute)}
h1{font-size:clamp(30px,5.6vw,48px);font-weight:900;line-height:1.12}
h1 .cls{color:var(--gold)}
h1 .dot{color:var(--faint);margin:0 .2em}
.lede{max-width:66ch;color:var(--ink-2);font-size:16px;margin:0;line-height:1.75}
.lede b{color:var(--ink);font-weight:700}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1px solid var(--line);background:var(--panel);border-radius:999px;padding:4px 12px;font-size:13px;color:var(--mute)}
.chip b{color:var(--ink);font-weight:500}

/* sticky stage nav (outer wrap reserves 124px so scrolled links never slide under ← 全部手册) */
.nav{position:sticky;top:0;z-index:20;background:var(--nav-bg);
  -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav .wrap{padding-top:8px;padding-bottom:8px;padding-right:124px}
.nav-scroll{display:flex;align-items:center;gap:4px;overflow-x:auto;scrollbar-width:none}
.nav-scroll::-webkit-scrollbar{display:none}
.nav a{flex:none;font-size:13px;font-weight:500;color:var(--mute);padding:6px 10px;border-radius:7px;white-space:nowrap;transition:color .15s,background .15s}
.nav a .n{font:700 11px var(--mono);color:var(--faint);margin-right:4px}
.nav a:hover{color:var(--ink);background:var(--panel)}
.nav a.on{color:var(--on-gold);background:var(--gold);font-weight:700}
.nav a.on .n{color:var(--on-gold)}
.nav .sep{flex:none;width:1px;height:14px;background:var(--line);margin:0 4px}

/* prep: core skills + hard limit + duty checklist */
.cores{margin-top:18px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.core{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 15px;display:grid;gap:8px;align-content:start}
.core.main{border-color:var(--gold-dim);background:linear-gradient(180deg,var(--gold-bg),var(--panel) 55%)}
.core .top{display:flex;gap:10px;align-items:center}
.core .nm{font-weight:700;font-size:15.5px;line-height:1.25}
.core .cd{font:500 12px var(--mono);color:var(--mute);margin-top:2px}
.core.main .nm{color:var(--gold)}
.core p{margin:0;font-size:13.5px;line-height:1.6;color:var(--ink-2)}

.limit{margin-top:12px;background:var(--blood-bg);border:1px solid var(--blood-line);border-left:3px solid var(--blood);
  border-radius:10px;padding:12px 16px;font-size:14px;color:var(--ink-2);line-height:1.65}
.limit .h{font:700 12.5px var(--body);color:var(--blood);letter-spacing:.04em;margin-bottom:4px}
.limit b{color:var(--ink);font-weight:700}

.kicks-box{margin-top:18px;background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.kicks-head{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--line);background:var(--panel-2)}
.kicks-head h3{font-size:16px;font-weight:700}
.kicks-head span{font-size:13px;color:var(--mute);margin-left:auto}
.kicks{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1px;background:var(--panel)}
.kick{display:grid;gap:4px;padding:14px 16px;background:var(--panel);box-shadow:0 0 0 1px var(--line);transition:background .15s;position:relative}
.kick:hover{background:var(--panel-2)}
.kick .meta{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--mute)}
.kick .idx{font:700 11.5px var(--mono);color:var(--ink-2)}
.kick .go{margin-left:auto;color:var(--faint);font-size:12px}
.kick:hover .go{color:var(--ink)}
.kick .cast{font:700 16px/1.35 var(--display);color:var(--ink)}
.kick .why{font-size:13.5px;color:var(--ink-2);line-height:1.55}

{{TLCSS}}

/* route */
.route{margin-top:20px;position:relative;display:grid;gap:18px}
.route::before{content:"";position:absolute;left:19px;top:10px;bottom:10px;width:2px;background:var(--line)}
.stop{display:grid;grid-template-columns:40px 1fr;gap:14px}
.node{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font:900 16px var(--display);position:relative;z-index:1}
.stop.boss .node{background:var(--panel-2);border:2px solid var(--ink-2);color:var(--ink)}
.stop.trash .node{background:var(--panel-2);border:1px solid var(--line-2);color:var(--mute);font-size:12px;font-weight:700}
.stop-body{background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden;min-width:0}
.stop.boss .stop-body{border-color:var(--line-2)}
.stop-head{padding:13px 16px;display:flex;align-items:baseline;gap:10px;border-bottom:1px solid var(--line);flex-wrap:wrap;background:var(--panel-2)}
.stop-head h3{font-size:18px;font-weight:900}
.stop.trash .stop-head h3{font-size:16.5px;font-weight:700;color:var(--ink)}
.stop-head .kind{font:700 11px var(--mono);letter-spacing:.1em;color:var(--mute)}
.stop.boss .stop-head .kind{color:var(--ink-2)}

.rhythm{padding:10px 16px;font-size:13.5px;color:var(--ink-2);background:var(--tint-1);border-bottom:1px solid var(--line);line-height:1.65}
.rhythm .lbl{font:700 11.5px var(--body);color:var(--ink);margin-right:8px;letter-spacing:.04em}
.rhythm b{color:var(--ink);font-weight:700}
.rhythm.warn{background:var(--blood-bg);color:var(--ink)}
.rhythm.warn .lbl{color:var(--blood)}

.rows{display:grid}
.row{display:grid;grid-template-columns:minmax(190px,1.15fr) 20px minmax(150px,.95fr) minmax(180px,1.25fr);gap:10px 12px;align-items:center;padding:12px 16px;border-bottom:1px solid var(--line)}
.row:last-child{border-bottom:0}
.row.must{background:var(--gold-bg);border-left:3px solid var(--gold);padding-left:13px}
.row:target{outline:2px solid var(--ink-2);outline-offset:-2px;background:var(--tint-2)}
.mech{display:flex;gap:10px;align-items:center;min-width:0}
.mech .n{font-weight:700;font-size:15px;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.mech .s{font-size:12.5px;color:var(--mute);margin-top:1px}
.badge-must{font:700 11px/1 var(--body);color:var(--on-gold);background:var(--gold);padding:3px 6px;border-radius:4px;letter-spacing:.02em}
.row .to{color:var(--faint);text-align:center;font-weight:700}
.row.must .to{color:var(--gold)}
.skill{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.btn-chip{display:inline-flex;align-items:center;gap:6px;font-size:13.5px;font-weight:700;color:var(--ink);
  background:var(--panel-2);border:1px solid var(--line-2);border-radius:7px;padding:3px 9px 3px 4px;white-space:nowrap}
.row.must .btn-chip.pri{border-color:var(--gold-dim);background:var(--gold-chip);color:var(--gold)}
.tgt{font-size:12.5px;color:var(--mute);font-weight:500}
.act-note{font-size:13px;color:var(--mute)}
.or{font-size:12px;color:var(--faint)}
.row .why{font-size:13.5px;color:var(--ink-2);line-height:1.6}
.row .why b{color:var(--ink);font-weight:700}

/* step sequence inside boss stop */
.subhead{padding:10px 16px 6px;font:700 12px var(--body);color:var(--mute);letter-spacing:.04em;border-top:1px solid var(--line);background:var(--tint-1)}
.row.step{grid-template-columns:minmax(72px,auto) minmax(150px,1fr) minmax(160px,1fr) minmax(180px,1.25fr)}
.row.step .when{font:700 12.5px var(--mono);color:var(--mute);white-space:nowrap}
.row.step.must .when{color:var(--gold)}
.row.step .mech{gap:8px}

/* soak comparison bars */
.bars{padding:8px 16px 14px;display:grid;gap:8px}
.bar-row{display:grid;grid-template-columns:108px 1fr;gap:12px;align-items:center;font-size:13px;color:var(--mute)}
.bar{height:24px;background:var(--panel-2);border-radius:6px;position:relative;overflow:hidden}
.bar span{position:absolute;inset:0 auto 0 0;border-radius:6px;display:flex;align-items:center;justify-content:flex-end;padding-right:8px;font:700 12px var(--mono);color:var(--on-bar);white-space:nowrap;min-width:52px}
.bar .off{background:var(--bar-off)}
.bar .mid{background:var(--bar-mid)}
.bar .zero{background:none;color:var(--ink);justify-content:flex-start;padding-left:8px}

.stop-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:10px 16px;
  border-top:1px solid var(--line);background:var(--panel-2);font-size:13px;color:var(--mute)}
.stop-foot .plan{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.stop-foot .plan img{vertical-align:-4px;margin-right:4px}
.stop-foot .next{color:var(--ink-2);font-weight:500}
.stop-foot .next:hover{color:var(--ink);text-decoration:underline}

/* talents */
.talent{margin-top:18px;background:var(--panel);border:1px solid var(--line-2);border-radius:14px;padding:18px;display:grid;gap:16px}
.code-row{display:flex;gap:10px;align-items:stretch}
.code-row code{flex:1;min-width:0;font:500 13px/1.5 var(--mono);color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px 12px;word-break:break-all;user-select:all}
.code-row button{flex:none;font:700 14px var(--body);color:var(--on-gold);background:var(--gold);border:0;border-radius:8px;padding:0 20px;cursor:pointer}
.code-row button:hover{filter:brightness(1.08)}
.tal-label{font-size:13px;font-weight:700;color:var(--mute);margin:0}
.tal-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.tal{display:flex;gap:10px;align-items:center;padding:11px 12px;border:1px solid var(--line);border-radius:10px;background:var(--panel-2);font-size:13.5px}
.tal.key{border-color:var(--line-2)}
.tal b{font-size:14px;color:var(--ink);display:block;margin-bottom:2px}
.tal span{display:block;color:var(--ink-2);line-height:1.5}
.tal-note{font-size:13.5px;color:var(--mute);margin:0;line-height:1.6}
.tal-note b{color:var(--ink);font-weight:600}

footer{padding:36px 0 54px;border-top:1px solid var(--line);margin-top:44px;color:var(--mute);font-size:13px}
.refs{display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:8px}
.refs a{color:var(--ink-2);border-bottom:1px dotted var(--faint)}
.refs a:hover{color:var(--ink);border-bottom-color:var(--ink)}

@media (max-width:760px){
  .wrap{padding:0 16px}
  .row,.row.step{grid-template-columns:1fr;gap:6px}
  .row .to{display:none}
  .route::before{left:15px}
  .stop{grid-template-columns:32px 1fr;gap:10px}
  .node{width:32px;height:32px;font-size:14px}
  .tal-grid{grid-template-columns:1fr}
  .code-row{flex-direction:column}
  .code-row button{padding:10px 20px}
  .bar-row{grid-template-columns:88px 1fr}
}
@media (prefers-reduced-motion:reduce){
  *{transition:none!important}
  html{scroll-behavior:auto}
}
</style>
</head>
