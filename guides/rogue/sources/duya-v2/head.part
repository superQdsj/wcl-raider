<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>潜行者 · 毒牙祭坛</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@600;900&family=Noto+Sans+SC:wght@400;500;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
/* 一张敏锐贼作战卡：毒牙祭坛是蛇神的毒林——毒林夜色底。潜行者金是唯一强调色；绿留给毒和闪避，紫留给消失，红留给流血。 */
:root{
  --bg:#0d1210; --panel:#141b18; --panel-2:#1a231f; --line:#27322d;
  --ink:#ebe7da; --mute:#97a39b; --faint:#5f6c65;
  --gold:#f2d24b; --gold-dim:#8a7a2c;
  --shadow:#b59cf0; --arcane:#7fb0f5; --blood:#e46a5e; --nature:#8fcf86; --steel:#9fb3c3;
  --display:"Noto Serif SC","Songti SC","STSong",serif;
  --body:"Noto Sans SC","PingFang SC","Microsoft YaHei",system-ui,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,Menlo,monospace;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{background:var(--bg)}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.65 var(--body);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--gold);outline-offset:2px;border-radius:4px}
img.ic{width:28px;height:28px;border-radius:6px;border:1px solid #000;box-shadow:0 0 0 1px var(--line);flex:none;display:block}
img.ic.lg{width:44px;height:44px;border-radius:9px}
img.ic.sm{width:22px;height:22px;border-radius:5px}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
h1,h2,h3{font-family:var(--display);text-wrap:balance;margin:0;letter-spacing:.01em}
h2{font-size:24px;font-weight:900;display:flex;align-items:baseline;gap:14px}
h2 .k{font:700 12px var(--mono);color:var(--gold);letter-spacing:.12em}
.sub{color:var(--mute);font-size:14px;margin:6px 0 0}
section{padding:44px 0 8px}
.mono{font-family:var(--mono);font-variant-numeric:tabular-nums}

/* hero */
header{border-bottom:1px solid var(--line);background:
  radial-gradient(900px 320px at 88% -40%,rgba(242,210,75,.14),transparent 70%),
  radial-gradient(700px 260px at 0% 130%,rgba(134,201,124,.09),transparent 70%)}
header .wrap{padding-top:44px;padding-bottom:34px;display:grid;gap:18px}
.eyebrow{font:700 12px var(--mono);letter-spacing:.16em;color:var(--mute)}
h1{font-size:clamp(32px,6vw,52px);font-weight:900;line-height:1.1}
h1 .cls{color:var(--gold)}
h1 .dot{color:var(--faint);margin:0 .2em}
.lede{max-width:64ch;color:#ddd6c4;font-size:16px;margin:0}
.lede b{color:var(--gold);font-weight:700}
.lede em{font-style:normal;color:var(--shadow);font-weight:700}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1px solid var(--line);background:var(--panel);border-radius:999px;padding:4px 12px;font-size:13px;color:var(--mute)}
.chip b{color:var(--ink);font-weight:500}

/* timeline (same as the gold rogue card) */
.tl-card{margin-top:18px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px 18px 12px}
.tl-scroll{overflow-x:auto;padding-bottom:6px}
.tl{position:relative;min-width:980px;height:232px}
.band{position:absolute;top:84px;z-index:0;height:30px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:12px;white-space:nowrap;overflow:hidden}
.band.trash{background:var(--panel-2);color:var(--faint);border:1px dashed var(--line)}
.band.boss{background:rgba(242,210,75,.12);color:var(--gold);border:1px solid var(--gold-dim);font-weight:700}
.axis{position:absolute;top:212px;font:500 11px var(--mono);color:var(--faint);transform:translateX(-50%)}
.mk{position:absolute;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;width:96px;z-index:1}
.mk .stem{width:2px;background:var(--gold)}
.mk img{width:22px;height:22px;border-radius:50%;border:2px solid var(--gold);background:#000}
.mk .lab{font-size:12px;line-height:1.3;text-align:center;color:var(--ink)}
.mk .t{font:500 11px var(--mono);color:var(--mute)}
.mk.up{top:4px}
.mk.up .lab{order:0}.mk.up .t{order:1}.mk.up img{order:2}.mk.up .stem{order:3;height:24px}
.mk.dn{top:114px}
.mk.dn .stem{order:0}.mk.dn img{order:1}.mk.dn .t{order:2}.mk.dn .lab{order:3}
.mk.dn .stem{height:14px}
.mk.v .stem{background:var(--shadow)}.mk.v img{border-color:var(--shadow)}
.mk.e .stem{background:var(--nature)}.mk.e img{border-color:var(--nature)}
.mk.muted .stem{background:var(--faint)}.mk.muted img{border-color:var(--faint);filter:grayscale(.7)}.mk.muted .lab{color:var(--mute)}
.mk.end{transform:translateX(-80%)}
.mk.start{transform:translateX(-20%)}
.legend{display:flex;flex-wrap:wrap;gap:16px;font-size:12px;color:var(--mute);margin-top:8px}
.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;vertical-align:-2px;margin-right:6px}

/* key moments */
.moments{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px;margin-top:20px}
.mo{background:var(--panel);border:1px solid var(--line);border-top:3px solid var(--gold);border-radius:12px;padding:16px;display:grid;gap:10px;align-content:start}
.mo .where{font:700 11px var(--mono);letter-spacing:.1em;color:var(--mute)}
.mo .sig{font-size:14px;color:var(--mute)}
.mo .sig b{color:var(--ink);font-size:16px;font-weight:700;display:block}
.mo .act{display:flex;align-items:center;gap:10px;font-weight:700;font-size:17px;flex-wrap:wrap}
.mo .act .nm{white-space:nowrap}
.mo .act .arrow{color:var(--gold);font-size:18px}
.mo p{margin:0;font-size:14px;color:#d3ccb9}

/* pills & tags */
.pill{display:inline-block;font-size:11px;font-weight:700;padding:1px 7px;border-radius:5px;line-height:18px;white-space:nowrap}
.p-imm{background:rgba(242,210,75,.16);color:var(--gold)}
.p-clr{background:rgba(143,207,134,.16);color:var(--nature)}
.p-van{background:rgba(181,156,240,.16);color:var(--shadow)}
.p-dr{background:rgba(127,176,245,.16);color:var(--arcane)}
.p-mv{background:rgba(255,255,255,.07);color:var(--mute)}
.p-heal{background:rgba(228,106,94,.15);color:var(--blood)}
.tag{display:inline-block;font-size:11px;color:var(--mute);border:1px solid var(--line);border-radius:4px;padding:0 5px;margin-right:4px;line-height:17px;white-space:nowrap}
.tag.magic{color:var(--arcane);border-color:rgba(127,176,245,.35)}
.tag.bleed{color:var(--blood);border-color:rgba(228,106,94,.35)}
.tag.poison{color:var(--nature);border-color:rgba(143,207,134,.35)}
.tag.phys{color:var(--steel);border-color:rgba(159,179,195,.35)}

/* findings */
.finding{margin-top:20px;display:grid;grid-template-columns:1.1fr 1fr;gap:24px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:22px}
.finding+.finding{margin-top:16px}
.finding h3{font-size:20px;font-weight:900;display:flex;gap:10px;align-items:center}
.finding p{margin:10px 0 0;color:#d6cfbc;font-size:14.5px}
.finding p b{color:var(--gold)}
.finding p em{font-style:normal;color:var(--shadow);font-weight:700}
.viz{display:grid;gap:12px;align-content:center;min-width:0}
.viz .cap{font-size:12px;color:var(--faint);line-height:1.5}
.bar-row{display:grid;grid-template-columns:118px 1fr;gap:10px;align-items:center;font-size:13px;color:var(--mute)}
.bar-row .n{display:block;font-size:11.5px;color:var(--faint)}
.bar{height:28px;background:var(--panel-2);border-radius:6px;position:relative;overflow:hidden}
.bar span{position:absolute;inset:0 auto 0 0;border-radius:6px;display:flex;align-items:center;justify-content:flex-end;padding-right:8px;font:700 12.5px var(--mono);color:#15120a;white-space:nowrap;min-width:52px}
.bar .off{background:#8e887a}
.bar .on{background:var(--gold)}
.bar .vn{background:var(--shadow)}
.bar .zero{background:none;color:var(--gold);justify-content:flex-start;padding-left:8px}
.big{font:700 28px var(--mono);color:var(--gold)}
.big small{font:500 13px var(--body);color:var(--mute);margin-left:8px}
.split{display:flex;gap:8px;flex-wrap:wrap;font-size:12.5px;color:var(--mute);align-items:center}
.split i{width:14px;height:14px;border-radius:50%;display:inline-block;border:2px solid var(--shadow)}
.split i.k{border-color:var(--gold)}
/* who-did-what grid */
.grid4{display:grid;grid-template-columns:104px repeat(4,1fr);gap:5px;font-size:12px;align-items:center}
.grid4 .h{font:700 11px var(--mono);color:var(--faint);text-align:center}
.grid4 .p{font:500 11.5px var(--mono);color:var(--mute);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.grid4 .c{height:26px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-weight:700;white-space:nowrap}
.c.F{background:rgba(127,176,245,.14);color:var(--arcane)}
.c.K{background:rgba(242,210,75,.2);color:var(--gold)}
.c.FV{background:rgba(127,176,245,.3);color:#cfe0ff}

/* step sequence */
.steps{display:grid;gap:10px;counter-reset:st}
.st{display:grid;grid-template-columns:54px 1fr;gap:12px;align-items:start;background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.st .when{font:700 12px var(--mono);color:var(--gold);padding-top:3px}
.st .what{font-size:13.5px;color:#d6cfbc}
.st .what b{color:var(--ink)}
.st .btns{display:flex;gap:6px;align-items:center;margin-top:6px;flex-wrap:wrap;font-size:12.5px;color:var(--mute)}
.st.alt{border-style:dashed}
.st.alt .when{color:var(--nature)}

/* route */
.route{margin-top:22px;position:relative;display:grid;gap:18px}
.route::before{content:"";position:absolute;left:19px;top:10px;bottom:10px;width:2px;background:linear-gradient(var(--line),var(--gold-dim),var(--line))}
.stop{display:grid;grid-template-columns:40px 1fr;gap:14px}
.node{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font:900 16px var(--display);position:relative;z-index:1}
.stop.boss .node{background:var(--gold);color:#17140a}
.stop.trash .node{background:var(--panel-2);border:2px solid var(--line);color:var(--faint);font-size:12px}
.stop-body{background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden;min-width:0}
.stop.boss .stop-body{border-color:#3d3624}
.stop-head{padding:12px 16px;display:flex;align-items:baseline;gap:10px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.stop-head h3{font-size:18px;font-weight:900}
.stop.trash .stop-head h3{font-size:16px;font-weight:600;color:#d3ccb9}
.stop-head .kind{font:700 11px var(--mono);letter-spacing:.1em;color:var(--mute)}
.row{display:grid;grid-template-columns:minmax(180px,1.15fr) 24px minmax(150px,1fr) minmax(150px,1.1fr);gap:12px;align-items:center;padding:11px 16px;border-bottom:1px solid var(--line)}
.row:last-of-type{border-bottom:0}
.mech{display:flex;gap:10px;align-items:center}
.mech .n{font-weight:700}
.mech .s{font-size:12.5px;color:var(--mute)}
.row .to{color:var(--gold);text-align:center;font-weight:700}
.skill{display:flex;gap:9px;align-items:center;font-weight:700;flex-wrap:wrap}
.row .why{font-size:13.5px;color:#d3ccb9}
.row .why .d{display:block;font:500 11.5px var(--mono);color:var(--faint);margin-top:2px}
.note{padding:10px 16px;font-size:13.5px;background:rgba(242,210,75,.06);color:#dcd2b4;border-top:1px solid var(--line)}
.note.warn{background:rgba(228,106,94,.08);color:#f0b6ae}
.note b{color:var(--gold)}
.note.warn b{color:var(--blood)}

/* toolbox */
.tools{margin-top:20px;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.tool{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px;display:grid;gap:8px;align-content:start}
.tool .top{display:flex;gap:10px;align-items:center}
.tool .nm{font-weight:700;font-size:16px}
.tool .dl{display:grid;grid-template-columns:44px 1fr;gap:3px 8px;font-size:13px;margin:0}
.tool .dl dt{color:var(--faint)}
.tool .dl dd{margin:0;color:#d6cfbc}
.tool.star{border-color:var(--gold-dim);background:linear-gradient(180deg,rgba(242,210,75,.08),var(--panel) 60%)}

/* debuffs */
.tbl-wrap{margin-top:18px;overflow-x:auto;border:1px solid var(--line);border-radius:12px}
table{width:100%;border-collapse:collapse;min-width:640px;background:var(--panel)}
th{font:700 11px var(--mono);letter-spacing:.1em;color:var(--mute);text-align:left;padding:10px 14px;background:var(--panel-2);border-bottom:1px solid var(--line)}
td{padding:10px 14px;border-bottom:1px solid var(--line);font-size:14px;vertical-align:middle}
tr:last-child td{border-bottom:0}
.dname{display:flex;gap:10px;align-items:center;font-weight:700}
.yes{color:var(--nature);font-weight:700}
.no{color:var(--faint)}

/* talents */
.talent{margin-top:18px;background:var(--panel);border:1px solid var(--gold-dim);border-radius:14px;padding:18px;display:grid;gap:16px}
.code-row{display:flex;gap:10px;align-items:stretch}
.code-row code{flex:1;min-width:0;font:500 13px/1.5 var(--mono);color:var(--gold);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px 12px;word-break:break-all;user-select:all}
.code-row button{flex:none;font:700 14px var(--body);color:#17140a;background:var(--gold);border:0;border-radius:8px;padding:0 20px;cursor:pointer}
.code-row button:hover{filter:brightness(1.08)}
.code-row button:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.tal-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px}
.tal{display:flex;gap:10px;align-items:center;padding:10px;border:1px solid var(--line);border-radius:10px;background:var(--panel-2);font-size:13px}
.tal b{font-size:14px;margin-right:4px}
.tal span{display:block;color:var(--mute)}
.tal.key{border-color:var(--gold-dim)}
.tal.key b{color:var(--gold)}
.tal-note{font-size:13px;color:var(--mute);margin:0}
.tal-note b{color:var(--ink);font-weight:500}
.refs{font-size:12.5px;color:var(--faint);display:flex;flex-wrap:wrap;gap:6px 14px}
.refs a{color:var(--mute);border-bottom:1px dotted var(--faint)}
.refs a:hover{color:var(--gold)}
footer{padding:40px 0 56px;color:var(--faint);font-size:12px}

@media (max-width:760px){
  .wrap{padding:0 16px}
  .finding{grid-template-columns:1fr;padding:18px}
  .row{grid-template-columns:1fr;gap:6px}
  .row .to{display:none}
  .row .skill::before{content:"→";color:var(--gold);margin-right:2px}
  .route::before{left:15px}
  .stop{grid-template-columns:32px 1fr;gap:10px}
  .node{width:32px;height:32px;font-size:14px}
  .bar-row{grid-template-columns:92px 1fr}
  .grid4{grid-template-columns:78px repeat(4,1fr);gap:4px}
  .grid4 .c{font-size:11px}
  .code-row{flex-direction:column}
  .code-row button{padding:10px 20px}
}
@media (prefers-reduced-motion:no-preference){
  .mo,.tool{transition:border-color .2s}
  .mo:hover,.tool:hover{border-color:var(--gold-dim)}
}
</style>
