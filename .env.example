# 复制为 .env（或 ~/.config/wcl-raider/credentials.env），填入在
# https://www.warcraftlogs.com/api/clients/ 获取的凭据（切勿提交真实密钥到仓库）
# 推荐优先配置 v1 API Key（限额更宽松，配置后默认优先使用 v1）
WCL_V1_API_KEY=
# 可选：v2 OAuth 客户端凭据（无 v1 key 时自动回退到 v2；`wcl.py query` 执行 GraphQL 需要 v2）
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
# 可选：强制指定 API 版本（auto=默认优先 v1，v1，v2）
# WCL_API_VERSION=auto
# 可选：名称语言 zh（默认，经 cn.warcraftlogs.com 翻译为中文）或 en
# WCL_LANG=zh
